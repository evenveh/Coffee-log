{
  "permissions": {
  "deny": ["Read(./.env*)", "Edit(./.env*)", "Read(**/secrets/**)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secrets.js\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
